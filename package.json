{
  "name": "rwahub",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "node scripts/require-env.js && concurrently -k \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "node scripts/require-env.js && vite",
    "dev:backend": "node scripts/require-env.js && nodemon src/server/server.js",
    "start": "node scripts/require-env.js && node src/server/server.js",
    "build": "node scripts/require-env.js && vite build",
    "compile": "hardhat compile",
    "chain": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy.js --network localhost"
  },
  "dependencies": {
    "@headlessui/react": "^1.7.18",
    "@radix-ui/react-checkbox": "^1.2.3",
    "@radix-ui/react-dialog": "^1.1.11",
    "@radix-ui/react-select": "^2.2.2",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-tooltip": "^1.2.4",
    "axios": "^1.9.0",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "date-fns": "^3.3.1",
    "dotenv": "^16.3.1",
    "ethers": "^5.7.2",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.0",
    "framer-motion": "^11.0.3",
    "glogg": "^2.2.0",
    "helmet": "^7.2.0",
    "ipfs-http-client": "^60.0.1",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.323.0",
    "morgan": "^1.12.1",
    "multer": "^2.3.0",
    "pinata": "^2.2.1",
    "pngjs": "^7.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-dropzone": "^14.2.3",
    "react-hot-toast": "^2.4.1",
    "react-router-dom": "^6.22.0",
    "sharp": "^0.32.6",
    "sonner": "^2.0.3",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^9.0.1",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@nomiclabs/hardhat-ethers": "^2.2.3",
    "@openzeppelin/contracts": "^4.9.6",
    "@openzeppelin/contracts-upgradeable": "^4.9.6",
    "@types/node": "^20.11.16",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "concurrently": "^8.2.2",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "hardhat": "^2.22.18",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "postcss": "^8.4.33",
    "supertest": "^6.3.3",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.2.2",
    "vite": "^5.0.8"
