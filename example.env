# Copy this file, then fill in local values:
#   macOS / Linux:  cp example.env .env
#   Windows PowerShell:  Copy-Item example.env .env
#
# Do not commit .env. example.env is the safe template.

# Server
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Frontend → API (Vite). Leave as /api when using the Vite proxy.
VITE_API_URL=/api

# JWT for Express auth. Change this locally; never use a real secret in git.
JWT_SECRET=change-me-to-a-long-random-string

# Optional Pinata (IPFS). Leave empty to use local/mock upload.
PINATA_JWT=
PINATA_GATEWAY=https://gateway.pinata.cloud

# Optional blockchain providers (not required for the local Hardhat demo)
ETHERSCAN_API_KEY=
INFURA_API_KEY=
POLYGON_RPC_URL=
ETHEREUM_RPC_URL=
SEPOLIA_RPC_URL=
